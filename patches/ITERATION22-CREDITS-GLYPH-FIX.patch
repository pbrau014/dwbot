+/**
+ * Reconcile one narrow Credits icon-adornment pattern without rewriting OCR text:
+ * a single localized row token contains the complete valid Credits digits plus a
+ * trailing nonnumeric currency glyph (for example `317943®`), independent broad
+ * reads agree on those digits, and the only stable crop quorum has exactly one
+ * extra trailing zero (`3179430`) consistent with that glyph. Any competing
+ * stable group, independent conflict, or weak crop quorum fails closed.
+ * Returns the anchored digit string or an empty string.
+ */
+function selectAnchoredCreditAfterTrailingAdornment(anchor, stableGroups = [], candidates = []) {
+    const source = String(anchor?.source || '');
+    const text = String(anchor?.groupedText || anchor?.text || '').trim();
+    const digits = normaliseOcrNumber(anchor?.groupedDigits || anchor?.digits || '');
+    if (!source.includes('localized-word-geometry')) return '';
+    if (Array.isArray(anchor?.groupedWords) && anchor.groupedWords.length !== 1) return '';
+    if (!/^\d{5,9}[^\d\s,.'’`]+$/u.test(text)) return '';
+    const textDigits = text.match(/^\d+/)?.[0] || '';
+    if (!/^\d{5,9}$/.test(digits) || textDigits !== digits) return '';
+    if (!hasIndependentRewardFieldValueSupport('credits', digits, candidates)) return '';
+    if (hasIndependentRewardFieldConflict('credits', digits, candidates)) return '';
+    if (!Array.isArray(stableGroups) || stableGroups.length !== 1) return '';
+    const group = stableGroups[0];
+    if (normaliseOcrNumber(group?.value) !== `${digits}0`) return '';
+    if ((group?.reads?.length ?? 0) < 6) return '';
+    const geometryCount = group?.geometries instanceof Set ? group.geometries.size : Number(group?.geometries) || 0;
+    const psmCount = group?.psms instanceof Set ? group.psms.size : Number(group?.psms) || 0;
+    if (geometryCount < 3 || psmCount < 2) return '';
+    if (hasIndependentRewardFieldValueSupport('credits', group.value, candidates)) return '';
+    return digits;
 }
