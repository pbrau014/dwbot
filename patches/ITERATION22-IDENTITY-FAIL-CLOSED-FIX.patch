+test('identity parsing repairs a clipped opening clan bracket only when the ship separator is present', () => {
+    const parsed = parseIdentityLine('Victory!\nOur team completed the primary task.\nHO-FL]VeritechCEO »» X THUNDERER');
+    assert.equal(parsed.player, '[HO-FL]VeritechCEO');
+    assert.equal(parsed.ship, 'X THUNDERER');
+});
+
+test('player consensus holds O/Q conflict when only one source family supports the selected spelling', () => {
+    const record = buildBattleRecord('Victory', completeFields({
+        identityCandidates: [
+            { text: 'Victory!\nOur team completed the primary task.\nHO-FL]VeritechCEO »» X THUNDERER', confidence: 74, weight: 1.5, source: 'prepared-identity-psm6' },
+            { text: 'Victory!\nOur team completed the primary task.\nHO-FL]VeritechCEQ »» X THUNDERER', confidence: 73, weight: 1.5, source: 'prepared-identity-psm11' },
+            { text: 'n completed the primary task.\nitechCEQ ¥» X THUNDERER', confidence: 79, weight: 1.1, source: 'source-identity-psm6' },
+            { text: 'n completed the primary task.\n itechCEO 7» X THUNDERER', confidence: 78, weight: 1.1, source: 'source-identity-psm11' },
+            { text: '[HO-FL]VeritechCEQ »» X THUNDERER', confidence: 76, weight: 0.7, source: 'full-screen-psm3' },
+            { text: '[HO-FL]VeritechCEQ »» X THUNDERER', confidence: 80, weight: 0.7, source: 'full-screen-psm11' },
+        ],
+    }));
+    assert.equal(record.player, NOT_DETECTED);
+    assert.ok(getMissingRequiredFields(record).some((field) => field.key === 'player'));
+});
